# SECURITY: This snippet adds no authentication or access control. Use it only
# inside a site already protected by a private network, VPN, or trusted access
# layer. Never expose Muxdeck directly to the public internet.
# Render @@BASE_PATH@@ and @@PORT@@, then put these routes inside the intended
# Caddy site block before any fallback handler. Keep the path prefix intact.
redir @@BASE_PATH@@ @@BASE_PATH@@/{?query}
handle @@BASE_PATH@@/* {
	reverse_proxy 127.0.0.1:@@PORT@@ {
		flush_interval -1
	}
}
